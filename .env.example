# 本地服务不自动读取 .env；按需在 shell 中导出以下非敏感配置。
# 默认只监听随机 loopback 端口，并使用当前用户的 Teamva 数据目录。
TEAMVA_LOCAL_HTTP_ADDR=127.0.0.1:0
# TEAMVA_LOCAL_DATA_DIR=/absolute/private/data-directory
# TEAMVA_LOCAL_WEB_DIR=/absolute/path/to/web/dist
# Provider 可执行文件覆盖（设置页「编程 CLI」保存的路径优先级更高）：
# TEAMVA_OPENCODE_PATH=/absolute/path/to/opencode
# TEAMVA_CODEX_PATH=/absolute/path/to/codex
# TEAMVA_LOCAL_DISABLE_RUNTIME=true  # 仅用于不执行任务的隔离 API 测试
# 局域网访问（默认关闭；令牌在应用内「设置 → 局域网访问」中设置）：
# TEAMVA_LOCAL_ALLOW_EXTERNAL=true
# TEAMVA_LOCAL_HTTP_ADDR=0.0.0.0:41720
# TEAMVA_LOCAL_ACCESS_TOKEN=<可选：仅当设置中尚未保存令牌时作为初始值，勿提交>
